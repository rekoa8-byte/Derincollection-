{
  "entities": {
    "product": {
      "title": "Product",
      "description": "A boutique product offered in the store",
      "type": "object",
      "properties": {
        "id": { "type": "number", "description": "Unique product ID" },
        "name": { "type": "string", "description": "Product title" },
        "description": { "type": "string", "description": "Product details" },
        "price": { "type": "number", "description": "Current selling price in IQD" },
        "oldPrice": { "type": "number", "description": "Original price before discount" },
        "category": { "type": "string", "description": "Category name" },
        "status": { "type": "string", "enum": ["available", "unavailable"], "description": "Product availability status" },
        "images": { "type": "array", "description": "Array of image URLs or base64 strings" },
        "video": { "type": "string", "description": "Optional video URL or base64" },
        "likes": { "type": "number", "description": "Like count" },
        "likedBy": { "type": "array", "description": "List of user identifiers who liked the product" }
      },
      "required": ["id", "name", "price", "category"]
    },
    "category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Kurdish category name" },
        "name_en": { "type": "string", "description": "English category name" },
        "name_ar": { "type": "string", "description": "Arabic category name" },
        "image": { "type": "string", "description": "Category banner or thumbnail image" },
        "emoji": { "type": "string", "description": "Emoji icon" }
      },
      "required": ["name"]
    },
    "order": {
      "title": "Order",
      "description": "Customer order details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Order reference code (e.g. ORD-1234)" },
        "items": { "type": "array", "description": "List of ordered items with quantities" },
        "subtotalIqd": { "type": "number", "description": "Subtotal in IQD" },
        "city": { "type": "string", "description": "Delivery city" },
        "shippingCost": { "type": "number", "description": "Delivery fee in IQD" },
        "totalIqd": { "type": "number", "description": "Grand total in IQD" },
        "date": { "type": "string", "description": "Order creation date string" },
        "status": { "type": "string", "enum": ["pending", "completed", "cancelled"], "description": "Order processing status" },
        "customer": { "type": "object", "description": "Customer contact and shipping details" }
      },
      "required": ["id", "items", "totalIqd", "status", "customer"]
    },
    "settings": {
      "title": "Settings",
      "description": "Store configuration and delivery cities",
      "type": "object",
      "properties": {
        "shopName": { "type": "string", "description": "Store name" },
        "logoUrl": { "type": "string", "description": "Logo URL" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "website": { "type": "string", "description": "Website URL" },
        "address": { "type": "string", "description": "Store physical address" },
        "tiktok": { "type": "string", "description": "TikTok handle" },
        "snapchat": { "type": "string", "description": "Snapchat handle" },
        "telegram": { "type": "string", "description": "Telegram handle" },
        "orderSound": { "type": "boolean", "description": "Whether order bell sound is enabled" },
        "cities": { "type": "array", "description": "List of shipping cities and costs" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "#/entities/product",
      "description": "Collection of products in the boutique"
    },
    "/categories/{categoryId}": {
      "schema": "#/entities/category",
      "description": "Collection of categories"
    },
    "/orders/{orderId}": {
      "schema": "#/entities/order",
      "description": "Collection of customer orders"
    },
    "/settings/{settingId}": {
      "schema": "#/entities/settings",
      "description": "Store settings document"
    }
  }
}
